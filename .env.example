# MikVoc configuration
# Salin file ini ke .env dan ubah nilainya.

# Secret key untuk session + enkripsi password router (AES-256-GCM).
# WAJIB di-set di produksi. Generate dengan: openssl rand -hex 32
MIKVOC_SECRET=change-me-to-random-32-byte-hex

# Port HTTP server.
MIKVOC_PORT=8080

# Path database SQLite.
MIKVOC_DB=mikvoc.db
